# Site Pulse Backend Environment Variables Example
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitepulse

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Production CORS Configuration (Optional in dev, set to frontend origin in production)
CORS_ORIGIN=https://your-site-pulse-frontend.vercel.app

